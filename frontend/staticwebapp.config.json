{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*",
      "/css/*",
      "/static/*",
      "/*.{css,js,map,ico,png,jpg,jpeg,gif,svg,webp,woff,woff2,ttf,eot,txt,json}"
    ]
  },

  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"],
      "rewrite": "https://pcs-api-dev-fdacbseyd9audvfg.centralus-01.azurewebsites.net/api/*"
    }
  ],

  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "geolocation=()"
  },

  "responseOverrides": {
    "401": {
      "rewrite": "/index.html"
    },
    "403": {
      "rewrite": "/index.html"
    }
  },

  "mimeTypes": {
    ".json": "application/json"
  }
}
