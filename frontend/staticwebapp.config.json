{
  "routes": [
    {
      "route": "/*",
      "redirect": "https://www.my-primarycare.com",
      "statusCode": 301,
      "conditions": {
        "host": ["my-primarycare.com"]
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/static/*",
      "/*.{css,js,map,ico,png,jpg,jpeg,gif,svg,webp,txt,xml,json}"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "geolocation=()"
  }
}




